 namespace ZeroTier {
 
+// LAB Android bridge: a positive localSocket is the monotonic UDP socket
+// generation.  When a newer generation first receives traffic, the physical
+// transport has changed and paths learned on the previous transport must not
+// remain eligible until the normal 243s peer-path expiration.
+class _ResetIPv4PhysicalPathsOnSocketChange {
+  public:
+    _ResetIPv4PhysicalPathsOnSocketChange(void* tPtr, int64_t now) : _tPtr(tPtr), _now(now)
+    {
+    }
+
+    inline void operator()(Topology& t, const SharedPtr<Peer>& p)
+    {
+        for (int scope = (int)InetAddress::IP_SCOPE_PSEUDOPRIVATE;
+             scope <= (int)InetAddress::IP_SCOPE_PRIVATE; ++scope) {
+            p->resetWithinScope(_tPtr, (InetAddress::IpScope)scope, AF_INET, _now);
+        }
+    }
+
+  private:
+    void* _tPtr;
+    int64_t _now;
+};
+
