 /* Public Node interface (C++, exposed via CAPI bindings)                   */
 /****************************************************************************/
@@ -53,6 +77,7 @@ Node::Node(void* uptr, void* tptr, const struct ZT_Node_Config* config, const st
 	, _lastGratuitousPingCheck(0)
 	, _lastHousekeepingRun(0)
 	, _lastMemoizedTraceSettings(0)
+	, _lastPositiveLocalSocket(-1)
 	, _lowBandwidthMode(false)
 {
 	if (callbacks->version != 0) {
@@ -207,6 +232,24 @@ Node::~Node()
 ZT_ResultCode Node::processWirePacket(void* tptr, int64_t now, int64_t localSocket, const struct sockaddr_storage* remoteAddress, const void* packetData, unsigned int packetLength, volatile int64_t* nextBackgroundTaskDeadline)
 {
 	_now = now;
+
+	bool resetPhysicalPaths = false;
+	if (localSocket > 0) {
+		Mutex::Lock _l(_localSocketGeneration_m);
+		if (_lastPositiveLocalSocket <= 0) {
+			_lastPositiveLocalSocket = localSocket;
+		}
+		else if (localSocket > _lastPositiveLocalSocket) {
+			_lastPositiveLocalSocket = localSocket;
+			resetPhysicalPaths = true;
+		}
+	}
+
+	if (resetPhysicalPaths) {
+		_ResetIPv4PhysicalPathsOnSocketChange resetter(tptr, now);
+		RR->topology->eachPeer<_ResetIPv4PhysicalPathsOnSocketChange&>(resetter);
+	}
+
 	RR->sw->onRemotePacket(tptr, localSocket, *(reinterpret_cast<const InetAddress*>(remoteAddress)), packetData, packetLength);
 	return ZT_RESULT_OK;
 }
